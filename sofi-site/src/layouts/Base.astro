---
// Basis-Layout: Design-Tokens, Header, Footer, SEO-Grundgerüst
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  noindex?: boolean;
}
const { title, description, schema = [], noindex = false } = Astro.props;
const canonicalPfad = Astro.url.pathname !== '/' && Astro.url.pathname.endsWith('/') ? Astro.url.pathname.slice(0, -1) : Astro.url.pathname;
const canonical = new URL(canonicalPfad, Astro.site);
const pfad = Astro.url.pathname;
const inSofi = pfad.startsWith('/sonnenfinsternis');

const nlTitel = inSofi
  ? 'Der SoFi-2027-Countdown'
  : 'Neue Ziele, neue Daten';
const nlText = inSofi
  ? 'Neue Orts-Analysen, Wolkendaten und Buchungs-Deadlines – etwa einmal im Monat, kein Spam.'
  : 'Wenn ein neuer Bereich fertig ist oder sich bei den Daten etwas tut – etwa einmal im Monat, kein Spam.';

---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {schema.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <style is:global>
    :root {
      --nacht: #14183c;
      --gold: #e8b44f;
      --papier: #fbfaf7;
      --tinte: #22252e;
      --grau: #8a8f9c;
      --linie: #e4e2db;
      --karte-bg: #f2f0ea;
    }
    * { margin: 0; box-sizing: border-box; }
    body {
      font: 16px/1.65 -apple-system, 'Segoe UI', Roboto, sans-serif;
      color: var(--tinte);
      background: var(--papier);
    }
    h1, h2, h3, .display { font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.01em; }
    a { color: var(--nacht); }
    .wrap { max-width: 980px; margin: 0 auto; padding: 0 20px; }
    header.site {
      border-bottom: 1px solid var(--linie);
      background: var(--papier);
    }
    header.site .wrap {
      display: flex; align-items: center; justify-content: space-between;
      padding-top: 14px; padding-bottom: 14px; gap: 16px; flex-wrap: wrap;
    }
    .logo {
      font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 18px;
      text-decoration: none; display: inline-flex; flex-direction: column; gap: 1px;
    }
    .logo .punkt { color: var(--gold); }
    .claim {
      font-family: -apple-system, 'Segoe UI', Roboto, sans-serif;
      font-size: 12px; font-weight: 500; color: var(--grau);
      letter-spacing: 0;
    }
    nav.sektion { border-bottom: 1px solid var(--linie); background: var(--karte-bg); }
    nav.sektion .wrap {
      display: flex; gap: 20px; flex-wrap: wrap;
      padding-top: 9px; padding-bottom: 9px;
    }
    nav.sektion a { font-size: 14.5px; text-decoration: none; color: var(--tinte); }
    nav.sektion a[aria-current="page"] { font-weight: 700; }
    nav.sektion a:hover { text-decoration: underline; text-underline-offset: 4px; }
    nav.main a { text-decoration: none; margin-left: 18px; font-size: 15px; color: var(--tinte); }
    nav.main a:hover { color: var(--nacht); text-decoration: underline; text-underline-offset: 4px; }
    main { padding: 36px 0 64px; }
    footer.site {
      border-top: 1px solid var(--linie);
      padding: 28px 0 40px;
      font-size: 13.5px; color: var(--grau);
    }
    footer.site a { color: var(--grau); }
    footer.site .cols { display: flex; gap: 32px; flex-wrap: wrap; justify-content: space-between; }
    .badge-total { display: inline-block; background: var(--nacht); color: #fff; padding: 2px 10px; border-radius: 11px; font-size: 12.5px; font-weight: 600; }
    .badge-partiell { display: inline-block; background: #edebe4; color: var(--tinte); padding: 2px 10px; border-radius: 11px; font-size: 12.5px; font-weight: 600; }
    table.daten { border-collapse: collapse; width: 100%; font-size: 15px; }
    table.daten th, table.daten td { text-align: left; padding: 8px 12px 8px 0; border-bottom: 1px solid var(--linie); }
    table.daten th { color: var(--grau); font-weight: 600; font-size: 13.5px; }
    .hinweisbox {
      background: var(--karte-bg); border-left: 3px solid var(--gold);
      padding: 14px 18px; border-radius: 0 8px 8px 0; font-size: 15px; margin: 22px 0;
    }
    .nl {
      background: var(--nacht); color: #fff; border-radius: 12px;
      padding: 26px 28px; margin-top: 44px;
    }
    .nl h2 { color: #fff; font-size: 20px; margin-bottom: 6px; }
    .nl p { color: #c9cbdd; font-size: 14.5px; margin-bottom: 14px; }
    .nl form { display: flex; gap: 10px; flex-wrap: wrap; }
    .nl input[type=email] {
      flex: 1; min-width: 220px; padding: 10px 14px; border-radius: 8px;
      border: none; font-size: 15px;
    }
    .nl .hp { position: absolute; left: -9999px; opacity: 0; height: 0; width: 0; }
    .nl-recht { color: #a8abc4; font-size: 12.5px; margin-top: 10px; }
    .nl-recht a { color: #c9cbdd; }
    .nl button {
      background: var(--gold); color: var(--nacht); border: none; border-radius: 8px;
      padding: 10px 20px; font-weight: 700; font-size: 15px; cursor: pointer;
      font-family: 'Space Grotesk', sans-serif;
    }
  </style>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a href="/" class="logo">
        <span>astro<span class="punkt">reisen</span></span>
        <span class="claim">Reisen zu Sonnenfinsternis, Nordlicht und Sternenhimmel</span>
      </a>
      <nav class="main">
        <a href="/sonnenfinsternis">Sonnenfinsternis</a>
        <a href="/ueber-mich">Über mich</a>
      </nav>
    </div>
  </header>
  {inSofi && (
    <nav class="sektion">
      <div class="wrap">
        <a href="/sonnenfinsternis" aria-current={pfad === '/sonnenfinsternis' ? 'page' : undefined}>Übersicht</a>
        <a href="/sonnenfinsternis/karte" aria-current={pfad.startsWith('/sonnenfinsternis/karte') ? 'page' : undefined}>Karte</a>
        <a href="/sonnenfinsternis/orte" aria-current={pfad.startsWith('/sonnenfinsternis/orte') ? 'page' : undefined}>Alle Orte</a>
        <a href="/sonnenfinsternis/guides" aria-current={pfad.startsWith('/sonnenfinsternis/guides') ? 'page' : undefined}>Guides</a>
        <a href="/sonnenfinsternis/methodik" aria-current={pfad.startsWith('/sonnenfinsternis/methodik') ? 'page' : undefined}>Methodik</a>
      </div>
    </nav>
  )}
  <main>
    <div class="wrap">
      <slot />
      <div class="nl">
        <h2>{nlTitel}</h2>
        <p>{nlText}</p>
        <form
          method="POST"
          action="https://7d0486af.sibforms.com/serve/MUIFAPlHEQbtEVu7C5x6dfrrd5aK5PeNn3sN2QLg330qzen-FJX5adKMFAVFYZamQkRsO0tJGzZbfKl21U8szeqYdyWDKA4OkRE8DwZn9zzJmDMwccQQ2mtqtQcI448dGeIHDotPnHLg7h5Hx355Xwj38yKj9py10RzvyXZjFo8_3dYk0vPbY5VP7GiOjUvrnM1yJMCS-PxHhGEqSA=="
        >
          <input type="email" name="EMAIL" placeholder="deine@email.ch" required />
          <button type="submit">Anmelden</button>
          {/* Honeypot gegen Bots – muss leer bleiben */}
          <input type="text" name="email_address_check" value="" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="locale" value="de" />
        </form>
        <p class="nl-recht">
          Mit der Anmeldung stimmst du zu, dass ich dir den Newsletter per E-Mail schicke.
          Abmeldung jederzeit über den Link in jeder Mail.
          <a href="/datenschutz">Datenschutz</a>
        </p>
      </div>
    </div>
  </main>
  <footer class="site">
    <div class="wrap cols">
      <div>
        © 2026 astroreisen.com ·
        <a href="/impressum">Impressum</a> ·
        <a href="/datenschutz">Datenschutz</a>
        {inSofi && <> · <a href="/sonnenfinsternis/methodik">Methodik &amp; Quellen</a></>}
      </div>
      <div style="max-width:420px">
        Transparenz: Diese Seite wird künftig durch Empfehlungs-Links (Affiliate) mitfinanziert.
        Für dich ändert sich am Preis nichts.
        {inSofi && (
          <> Berechnungen: eigene Pipeline (skyfield/DE421), validiert gegen NASA-Daten.
          Wolkenklimatologie: enthält modifizierte Copernicus Climate Change Service
          Informationen (ERA5).</>
        )}
      </div>
    </div>
  </footer>
</body>
</html>
