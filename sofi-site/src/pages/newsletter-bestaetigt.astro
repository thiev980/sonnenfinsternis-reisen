---
import Base from '../layouts/Base.astro';
import orte from '../data/orte.json';
const top = orte.filter(o => o.is_total).sort((a, b) => b.totality_s - a.totality_s).slice(0, 3);
---
<Base
  title="Anmeldung bestätigt – willkommen beim SoFi-2027-Countdown"
  description="Deine Anmeldung zum Newsletter ist bestätigt."
  noindex
>
  <article class="mitte">
    <p class="icon">🌑</p>
    <h1>Willkommen an Bord!</h1>
    <p class="lead">
      Deine Anmeldung ist bestätigt. Du bekommst von mir etwa einmal im Monat
      neue Orts-Analysen, Wetterdaten und Hinweise, wann es Zeit wird zu buchen.
    </p>
    <h2>Womit du direkt weitermachen kannst</h2>
    <ul class="links">
      <li><a href="/guides/spanien-marokko-oder-aegypten">Spanien, Marokko oder Ägypten? Der ehrliche Vergleich</a></li>
      <li><a href="/guides/klarer-himmel-wolken-wahrscheinlichkeit">Wo stehen die Chancen auf klaren Himmel am besten?</a></li>
      <li><a href="/karte">Die Totalitätszone auf der interaktiven Karte</a></li>
    </ul>
    <h2>Die drei längsten Totalitäten</h2>
    <table class="daten">
      <tbody>
        {top.map(o => (
          <tr>
            <td><a href={`/orte/${o.slug}`}>{o.name}</a></td>
            <td>{o.country}</td>
            <td><strong>{o.totality_str}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </article>
</Base>
<style>
  .mitte { max-width: 640px; margin: 0 auto; padding: 30px 0; }
  .icon { font-size: 44px; text-align: center; margin-bottom: 10px; }
  h1 { font-size: clamp(28px, 5vw, 40px); margin-bottom: 14px; text-align: center; }
  .lead { font-size: 18px; margin-bottom: 30px; text-align: center; }
  h2 { font-size: 20px; margin: 26px 0 10px; }
  .links { list-style: none; margin: 0; padding: 0; }
  .links li { border-top: 1px solid var(--linie); padding: 10px 0; }
</style>
