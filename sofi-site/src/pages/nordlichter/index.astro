---
import Base from '../../layouts/Base.astro';
import { headerBild } from '../../lib/bilder';
import Headerbild from '../../components/Headerbild.astro';
const bild = headerBild('seite/nordlichter');
import orte from '../../data/nordlicht_orte.json';
import { zahl } from '../../lib/format.js';

const MONATSNAME_LANG = {
  sep: 'September', okt: 'Oktober', nov: 'November', dez: 'Dezember',
  jan: 'Januar', feb: 'Februar', mär: 'März',
};

const top5 = [...orte]
  .sort((a, b) => b.monate[b.bester_monat].index - a.monate[a.bester_monat].index)
  .slice(0, 5);

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Nordlichter: Wo und wann',
  description: 'Reiseplanung für Nordlichter - geomagnetische Breite, Dunkelstunden und Wolkenklimatologie statt Reiseblog-Abschriften.',
}];
---
<Base
  title="Nordlichter: Wo und wann sich die Reise lohnt"
  description="Nordlicht-Reiseplanung mit eigenen Berechnungen: geomagnetische Breite, Dunkelstunden pro Saison und Wolkenklimatologie für 11 Orte von Kanada bis Skandinavien - transparent statt geraten."
  schema={schema}
  bild={bild}
>
  <section class="hero">
    <p class="eyebrow">September bis März · Nordhalbkugel</p>
    <h1>Wo ein Nordlicht wahrscheinlich ist. Und warum das nicht dasselbe ist wie sicher.</h1>
    <Headerbild bild={bild} alt="Nordlicht" />
    <p class="lead">
      Anders als eine Sonnenfinsternis lässt sich ein Nordlicht nicht auf die Minute vorausberechnen -
      die Sonnenaktivität ist erst wenige Tage vorher verlässlich einzuschätzen. Was sich aber berechnen
      lässt: wo die geomagnetische Lage, die Dunkelstunden und das Wetter über viele Jahre gemittelt am
      günstigsten zusammenkommen - für {orte.length} Orte von Kanada bis Skandinavien.
    </p>
    <div class="cta">
      <a class="btn primär" href="/nordlichter/karte">Zur interaktiven Karte</a>
      <a class="btn" href="/nordlichter/orte">Alle {orte.length} Orte im Vergleich</a>
      <a class="btn" href="/nordlichter/guides">Alle Guides</a>
    </div>
  </section>

  <section>
    <h2>Die besten Chancen gerade</h2>
    <table class="daten">
      <thead><tr><th>Ort</th><th>Land</th><th>Bester Monat</th><th>Index</th></tr></thead>
      <tbody>
        {top5.map((o) => (
          <tr>
            <td><a href={`/nordlichter/orte/${o.slug}`}>{o.name}</a></td>
            <td>{o.land}</td>
            <td>{MONATSNAME_LANG[o.bester_monat]}</td>
            <td><strong>{zahl(o.monate[o.bester_monat].index)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="tabellen-hinweis">
      Index = Dunkelstunden × Wahrscheinlichkeit auf klaren Himmel. Warum die bekanntesten Orte
      hier nicht automatisch vorne liegen, steht im{' '}
      <a href="/nordlichter/guides/tromsoe-abisko-oder-yellowknife">Datenvergleich</a>.
    </p>
  </section>

  <section class="guides-teaser">
    <h2>Die Entscheidungen vor der Reise</h2>
    <ul>
      <li>
        <a href="/nordlichter/guides/kp-index-und-vorhersage">Warum sich ein Nordlicht nicht wie eine Finsternis vorhersagen lässt</a>
        <p>Was ein Kp-Wert misst, welcher Zeithorizont wirklich verlässlich ist - und warum
        „ein Jahr im Voraus buchen" bei Nordlichtern eine andere Frage ist als bei einer Finsternis.</p>
      </li>
      <li>
        <a href="/nordlichter/guides/tromsoe-abisko-oder-yellowknife">Fairbanks, Tromsø oder Yellowknife?</a>
        <p>Der Datenvergleich über alle elf Orte - inklusive zweier Fälle, bei denen wir unseren
        eigenen Zahlen nicht vollständig trauen.</p>
      </li>
      <li>
        <a href="/nordlichter/guides/warum-nicht-dezember">Warum Dezember nicht automatisch die beste Zeit ist</a>
        <p>Die längste Nacht des Jahres liegt im Dezember. Der beste Reisemonat oft nicht -
        weil Dunkelheit nur die halbe Rechnung ist.</p>
      </li>
      <li>
        <a href="/nordlichter/guides/pauschalreise-oder-selbst-planen">Pauschalreise, geführte Tour oder selbst planen?</a>
        <p>Der Unterschied zur Finsternis: Eine Nordlicht-Tour kann in derselben Nacht dorthin
        fahren, wo der Himmel klar ist. Wann sich das lohnt.</p>
      </li>
    </ul>
  </section>
</Base>

<style>
  .hero { padding: 8px 0 32px; }
  .eyebrow { color: var(--grau); font-size: 14px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 10px; }
  h1 { font-size: clamp(28px, 5vw, 44px); line-height: 1.12; margin-bottom: 18px; }
  .lead { font-size: clamp(18px, 2.1vw, 21px); line-height: 1.6; }
  /* Titel → Bild → Text; alles in voller Breite. Der Lead ist dafür grösser gesetzt, damit die Zeilen
     nicht über ~90 Zeichen kommen. */
  .hero :global(.header-bild) { margin: 24px 0 26px; }
  .cta { margin-top: 18px; display: flex; gap: 12px; flex-wrap: wrap; }
  .btn {
    display: inline-block; padding: 11px 20px; border-radius: 9px; text-decoration: none;
    font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 15.5px;
    border: 1.5px solid var(--nacht); color: var(--nacht);
  }
  .btn.primär { background: var(--nacht); color: #fff; }

  section h2 { font-size: 24px; margin-bottom: 14px; }
  .tabellen-hinweis { color: var(--grau); font-size: 13.5px; margin-top: 10px; }

  .guides-teaser { margin-top: 40px; }
  .guides-teaser ul { list-style: none; margin: 0; padding: 0; max-width: 720px; }
  .guides-teaser li { border-top: 1px solid var(--linie); padding: 14px 0; }
  .guides-teaser a { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 17px; text-decoration: none; }
  .guides-teaser a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .guides-teaser p { color: var(--grau); font-size: 15px; margin-top: 4px; }
</style>